APP_ENV=staging

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

DATABASE_URL=

WHATSAPP_PROVIDER=baileys
WHATSAPP_AUTH_DIRECTORY=
# Staging live linked device (never enable in automated tests)
WHATSAPP_ENABLE_LIVE=false
# Text-first booking UX (recommended for Baileys staging). Set true only for experimental UI.
WHATSAPP_INTERACTIVE_UI=false

BOOKING_MODE=demo
LOG_LEVEL=info

# Public staging WhatsApp number for the website "Book on WhatsApp" button (digits with country code).
VITE_WHATSAPP_BOOKING_NUMBER=
